{
  "name": "edison-format-simulator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sim": "tsx scripts/sim.ts",
    "test": "tsx scripts/test.ts",
    "test:backup": "tsx scripts/backup-test.ts",
    "test:market": "tsx scripts/market-test.ts",
    "test:draft": "tsx scripts/draft-setup-test.ts",
    "test:rules": "tsx scripts/rules-test.ts",
    "test:core-rules": "tsx scripts/core-rules-test.ts",
    "test:chainless": "tsx scripts/chainless-test.ts",
    "test:undo": "tsx scripts/undo-test.ts --games 30",
    "test:replay": "tsx scripts/replay-test.ts --games 40",
    "test:sim": "tsx scripts/sim.ts --games 40",
    "test:packs": "tsx scripts/pack-odds-test.ts",
    "test:locals": "tsx scripts/locals-test.ts --nights 120",
    "test:events": "tsx scripts/events-test.ts --seasons 4",
    "test:crash-guard": "tsx scripts/crash-guard-test.ts",
    "test:events-recovery-e2e": "node scripts/events-recovery-e2e.cjs",
    "test:net": "tsx scripts/net-test.ts",
    "test:friend-e2e": "node scripts/friend-e2e.cjs",
    "test:tourney": "tsx scripts/tourney-test.ts",
    "test:friends-locals-e2e": "node scripts/friends-locals-e2e.cjs",
    "test:routes-e2e": "node scripts/routes-e2e.cjs",
    "test:css-snapshot": "node scripts/css-snapshot.cjs",
    "test:guide-e2e": "node scripts/guide-settings-e2e.cjs",
    "test:undo-e2e": "node scripts/undo-e2e.cjs",
    "test:monkey-e2e": "node scripts/monkey-e2e.cjs",
    "test:whynot-e2e": "node scripts/whynot-e2e.cjs",
    "test:swipe-e2e": "node scripts/swipe-e2e.cjs",
    "test:shop-e2e": "node scripts/shop-e2e.cjs",
    "test:ai": "tsx scripts/ai-planner-test.ts && tsx scripts/ai-strength.ts --games 96",
    "test:rulings": "tsx scripts/test.ts rulings/"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "peer": "^1.0.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "dependencies": {
    "peerjs": "^1.5.5"
  }
}
